{
	"info": {
		"name": "Toolshop API",
		"description": "Basic API checks for Practice Software Testing - Toolshop (https://api.practicesoftwaretesting.com). Positive and negative checks for products, search, brands, login and carts. Run the requests in order: 'Add item to cart' uses productId from 'Get products' and cartId from 'Create cart'.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Get products",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"const body = pm.response.json();",
							"",
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response time is less than 2000ms\", function () {",
							"    pm.expect(pm.response.responseTime).to.be.below(2000);",
							"});",
							"",
							"pm.test(\"Data array is not empty\", function () {",
							"    pm.expect(body.data).to.be.an(\"array\").that.is.not.empty;",
							"});",
							"",
							"pm.test(\"Pagination fields exist\", function () {",
							"    pm.expect(body).to.have.property(\"current_page\", 1);",
							"    pm.expect(body).to.have.property(\"total\");",
							"});",
							"",
							"// product ids change after data reset, so take the first one from the response",
							"pm.collectionVariables.set(\"productId\", body.data[0].id);"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/products",
					"host": ["{{baseUrl}}"],
					"path": ["products"]
				}
			},
			"response": []
		},
		{
			"name": "Search products - pliers",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"const body = pm.response.json();",
							"",
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Search returns results\", function () {",
							"    pm.expect(body.data).to.be.an(\"array\").that.is.not.empty;",
							"});",
							"",
							"pm.test(\"Every product name contains 'pliers'\", function () {",
							"    body.data.forEach(function (product) {",
							"        pm.expect(product.name.toLowerCase()).to.include(\"pliers\");",
							"    });",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/products/search?q=pliers",
					"host": ["{{baseUrl}}"],
					"path": ["products", "search"],
					"query": [
						{
							"key": "q",
							"value": "pliers"
						}
					]
				}
			},
			"response": []
		},
		{
			"name": "Get brands",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"const body = pm.response.json();",
							"",
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response is a non-empty array\", function () {",
							"    pm.expect(body).to.be.an(\"array\").that.is.not.empty;",
							"});",
							"",
							"pm.test(\"Each brand has id, name and slug\", function () {",
							"    body.forEach(function (brand) {",
							"        pm.expect(brand).to.include.keys(\"id\", \"name\", \"slug\");",
							"    });",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/brands",
					"host": ["{{baseUrl}}"],
					"path": ["brands"]
				}
			},
			"response": []
		},
		{
			"name": "Login - invalid credentials",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test(\"Status code is 401\", function () {",
							"    pm.response.to.have.status(401);",
							"});",
							"",
							"pm.test(\"Error message is Unauthorized\", function () {",
							"    pm.expect(pm.response.json()).to.eql({ error: \"Unauthorized\" });",
							"});",
							"",
							"pm.test(\"No access token in response\", function () {",
							"    pm.expect(pm.response.json()).to.not.have.property(\"access_token\");",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"invalid.user@example.com\",\n    \"password\": \"WrongPass123\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/users/login",
					"host": ["{{baseUrl}}"],
					"path": ["users", "login"]
				}
			},
			"response": []
		},
		{
			"name": "Create cart",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"const body = pm.response.json();",
							"",
							"pm.test(\"Status code is 201\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test(\"Response has cart id\", function () {",
							"    pm.expect(body.id).to.be.a(\"string\").that.is.not.empty;",
							"});",
							"",
							"pm.collectionVariables.set(\"cartId\", body.id);"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/carts",
					"host": ["{{baseUrl}}"],
					"path": ["carts"]
				}
			},
			"response": []
		},
		{
			"name": "Add item to cart",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Item is added\", function () {",
							"    pm.expect(pm.response.json().result).to.eql(\"item added or updated\");",
							"});",
							"",
							"pm.test(\"cartId was set by previous request\", function () {",
							"    pm.expect(pm.collectionVariables.get(\"cartId\")).to.not.be.empty;",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"product_id\": \"{{productId}}\",\n    \"quantity\": 1\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/carts/{{cartId}}",
					"host": ["{{baseUrl}}"],
					"path": ["carts", "{{cartId}}"]
				}
			},
			"response": []
		},
		{
			"name": "Get product - non-existent id",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test(\"Status code is 404\", function () {",
							"    pm.response.to.have.status(404);",
							"});",
							"",
							"pm.test(\"Error message is returned\", function () {",
							"    pm.expect(pm.response.json().message).to.eql(\"Requested item not found\");",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/products/non-existent-id-99999",
					"host": ["{{baseUrl}}"],
					"path": ["products", "non-existent-id-99999"]
				}
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "https://api.practicesoftwaretesting.com"
		},
		{
			"key": "productId",
			"value": ""
		},
		{
			"key": "cartId",
			"value": ""
		}
	]
}
