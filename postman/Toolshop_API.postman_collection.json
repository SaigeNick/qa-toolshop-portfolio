{
	"info": {
		"name": "Toolshop API",
		"description": "Basic API checks for Practice Software Testing - Toolshop (https://api.practicesoftwaretesting.com). Positive and negative checks for products, search, brands, login, current user and carts, plus an API reproduction of BUG-01 (KAN-4). Run the requests in order: the cart requests use productId from 'Get products' and cartId from 'Create cart', 'Get current user' uses authToken from 'Login - demo customer'.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Get products",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"const body = pm.response.json();",
							"",
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"// public demo server, so the limit is generous to avoid flaky failures",
							"pm.test(\"Response time is less than 5000ms\", function () {",
							"    pm.expect(pm.response.responseTime).to.be.below(5000);",
							"});",
							"",
							"pm.test(\"Data array is not empty\", function () {",
							"    pm.expect(body.data).to.be.an(\"array\").that.is.not.empty;",
							"});",
							"",
							"pm.test(\"Pagination fields exist\", function () {",
							"    pm.expect(body).to.have.property(\"current_page\", 1);",
							"    pm.expect(body).to.have.property(\"total\");",
							"});",
							"",
							"// product ids change after data reset, so take the first one from the response",
							"pm.collectionVariables.set(\"productId\", body.data[0].id);"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/products",
					"host": ["{{baseUrl}}"],
					"path": ["products"]
				}
			},
			"response": []
		},
		{
			"name": "Search products - pliers",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"const body = pm.response.json();",
							"",
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Search returns results\", function () {",
							"    pm.expect(body.data).to.be.an(\"array\").that.is.not.empty;",
							"});",
							"",
							"pm.test(\"Every product name contains 'pliers'\", function () {",
							"    body.data.forEach(function (product) {",
							"        pm.expect(product.name.toLowerCase()).to.include(\"pliers\");",
							"    });",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/products/search?q=pliers",
					"host": ["{{baseUrl}}"],
					"path": ["products", "search"],
					"query": [
						{
							"key": "q",
							"value": "pliers"
						}
					]
				}
			},
			"response": []
		},
		{
			"name": "Get brands",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"const body = pm.response.json();",
							"",
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response is a non-empty array\", function () {",
							"    pm.expect(body).to.be.an(\"array\").that.is.not.empty;",
							"});",
							"",
							"pm.test(\"Each brand has id, name and slug\", function () {",
							"    body.forEach(function (brand) {",
							"        pm.expect(brand).to.include.keys(\"id\", \"name\", \"slug\");",
							"    });",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/brands",
					"host": ["{{baseUrl}}"],
					"path": ["brands"]
				}
			},
			"response": []
		},
		{
			"name": "Login - invalid credentials",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test(\"Status code is 401\", function () {",
							"    pm.response.to.have.status(401);",
							"});",
							"",
							"pm.test(\"Error message is Unauthorized\", function () {",
							"    pm.expect(pm.response.json()).to.eql({ error: \"Unauthorized\" });",
							"});",
							"",
							"pm.test(\"No access token in response\", function () {",
							"    pm.expect(pm.response.json()).to.not.have.property(\"access_token\");",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"invalid.user@example.com\",\n    \"password\": \"WrongPass123\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/users/login",
					"host": ["{{baseUrl}}"],
					"path": ["users", "login"]
				}
			},
			"response": []
		},
		{
			"name": "Login - demo customer",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"const body = pm.response.json();",
							"",
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Access token is returned\", function () {",
							"    pm.expect(body.access_token).to.be.a(\"string\").that.is.not.empty;",
							"    pm.expect(body.token_type).to.eql(\"bearer\");",
							"});",
							"",
							"// token is valid for 5 minutes (expires_in: 300)",
							"pm.collectionVariables.set(\"authToken\", body.access_token);"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"customer@practicesoftwaretesting.com\",\n    \"password\": \"welcome01\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/users/login",
					"host": ["{{baseUrl}}"],
					"path": ["users", "login"]
				}
			},
			"response": []
		},
		{
			"name": "Get current user",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"const body = pm.response.json();",
							"",
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Returns the logged in user\", function () {",
							"    pm.expect(body.email).to.eql(\"customer@practicesoftwaretesting.com\");",
							"});",
							"",
							"pm.test(\"Password is not exposed\", function () {",
							"    pm.expect(body).to.not.have.property(\"password\");",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{authToken}}"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/users/me",
					"host": ["{{baseUrl}}"],
					"path": ["users", "me"]
				}
			},
			"response": []
		},
		{
			"name": "Create cart",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"const body = pm.response.json();",
							"",
							"pm.test(\"Status code is 201\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test(\"Response has cart id\", function () {",
							"    pm.expect(body.id).to.be.a(\"string\").that.is.not.empty;",
							"});",
							"",
							"pm.collectionVariables.set(\"cartId\", body.id);"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/carts",
					"host": ["{{baseUrl}}"],
					"path": ["carts"]
				}
			},
			"response": []
		},
		{
			"name": "Add item to cart - quantity 99",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Item is added\", function () {",
							"    pm.expect(pm.response.json().result).to.eql(\"item added or updated\");",
							"});",
							"",
							"pm.test(\"cartId was set by previous request\", function () {",
							"    pm.expect(pm.collectionVariables.get(\"cartId\")).to.not.be.empty;",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"product_id\": \"{{productId}}\",\n    \"quantity\": 99\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/carts/{{cartId}}",
					"host": ["{{baseUrl}}"],
					"path": ["carts", "{{cartId}}"]
				}
			},
			"response": []
		},
		{
			"name": "Add same item again - quantity 99 (BUG-01)",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"// BUG-01 / KAN-4: the line already has 99, so the API should reject this (e.g. 422).",
							"// Today it returns 200 - the test documents the current behaviour.",
							"pm.test(\"BUG-01 still present: second add of 99 is accepted (expected 422)\", function () {",
							"    pm.response.to.have.status(200);",
							"    pm.expect(pm.response.json().result).to.eql(\"item added or updated\");",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"product_id\": \"{{productId}}\",\n    \"quantity\": 99\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/carts/{{cartId}}",
					"host": ["{{baseUrl}}"],
					"path": ["carts", "{{cartId}}"]
				}
			},
			"response": []
		},
		{
			"name": "Get cart - check quantity (BUG-01)",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"const body = pm.response.json();",
							"",
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Cart has one line for the product\", function () {",
							"    pm.expect(body.id).to.eql(pm.collectionVariables.get(\"cartId\"));",
							"    pm.expect(body.cart_items).to.have.lengthOf(1);",
							"    pm.expect(body.cart_items[0].product_id).to.eql(pm.collectionVariables.get(\"productId\"));",
							"});",
							"",
							"// business rule: max 99 per cart line. When BUG-01 is fixed this test fails",
							"// and should be changed to: quantity is at most 99",
							"pm.test(\"BUG-01 still present: cart line quantity is 198 (rule: max 99)\", function () {",
							"    pm.expect(body.cart_items[0].quantity).to.eql(198);",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/carts/{{cartId}}",
					"host": ["{{baseUrl}}"],
					"path": ["carts", "{{cartId}}"]
				}
			},
			"response": []
		},
		{
			"name": "Get product - non-existent id",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test(\"Status code is 404\", function () {",
							"    pm.response.to.have.status(404);",
							"});",
							"",
							"pm.test(\"Error message is returned\", function () {",
							"    pm.expect(pm.response.json().message).to.eql(\"Requested item not found\");",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/products/non-existent-id-99999",
					"host": ["{{baseUrl}}"],
					"path": ["products", "non-existent-id-99999"]
				}
			},
			"response": []
		}
	],
